# Optional server-side proxy URL for natural sentence refinement via Gemini API.
# Leave unset to run 100% statically in the browser with the built-in rule-based gloss engine.
VITE_GLOSS_REFINER_ENDPOINT=""

# Optional server-side Gemini API key (used only if deploying an optional serverless proxy)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
